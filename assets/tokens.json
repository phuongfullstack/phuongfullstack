  "color": {
    "light": {
      "bg": "#FFFFFF", "bg-subtle": "#FAFAF8", "bg-inset": "#F2F1ED",
      "border": "#E6E4DE", "border-strong": "#CFCCC4",
      "text": "#111111", "text-muted": "#56534D", "text-faint": "#8C887F",
      "accent": "#5B2BD9", "accent-hover": "#4A1FC0", "accent-subtle": "#F1EBFF",
      "on-accent": "#FFFFFF"
    },
    "dark": {
      "bg": "#0E0E11", "bg-subtle": "#16161A", "bg-inset": "#1C1C21",
      "border": "#2A2A30", "border-strong": "#3D3D45",
      "text": "#F2F1EE", "text-muted": "#A3A099", "text-faint": "#736F68",
      "accent": "#A78BFA", "accent-hover": "#C4B5FD", "accent-subtle": "#1C1533",
      "on-accent": "#16161A"
    }
  },
  "radius": { "sm": 4, "md": 6, "lg": 10, "xl": 14 },
